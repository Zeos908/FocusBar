<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>FocusBar</Company>
    <Product>FocusBar</Product>
    <Version>0.9.1</Version>
    <!-- Lets the Windows-only app compile on Linux/macOS CI. It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
