<Window x:Class="FocusBar.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusBar Settings"
        Width="720" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FlyoutBackground}"
        Foreground="{DynamicResource FlyoutForeground}"
        FontFamily="{StaticResource BarFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Page list. Phase 7 adds Appearance here. -->
        <Border Background="{DynamicResource ItemHover}">
            <ListBox x:Name="Pages" Style="{StaticResource FlyoutList}" Margin="10,16" SelectionChanged="Pages_SelectionChanged"
                     AutomationProperties.Name="Settings pages">
                <ListBoxItem Tag="Reminders">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,10,0" />
                        <TextBlock Text="Reminders" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Sources">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,10,0" />
                        <TextBlock Text="Deadline sources" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Focus">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE708;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,10,0" />
                        <TextBlock Text="Focus Mode" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="PageHost" Margin="28,20,28,20" Focusable="False" />
        </ScrollViewer>
    </Grid>
</Window>
