<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 1809 (build 17763) is the minimum supported OS. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>FocusBar.App</RootNamespace>
    <AssemblyName>FocusBar</AssemblyName>
    <StartupObject>FocusBar.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main is the entry point (it handles the watchdog and restore modes before WPF starts),
         so App.xaml must not generate its own Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusBar.Core\FocusBar.Core.csproj" />
    <!-- Built first so its files can be copied next to FocusBar.exe (below); not referenced as a library. -->
    <ProjectReference Include="..\FocusBar.Blocker\FocusBar.Blocker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- FocusBar starts FocusBar.Blocker.exe (with a permission prompt) to block websites, so it must sit beside FocusBar.exe. -->
  <Target Name="CopyBlocker" AfterTargets="Build">
    <ItemGroup>
      <BlockerFiles Include="..\FocusBar.Blocker\bin\$(Configuration)\net8.0\FocusBar.Blocker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BlockerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
