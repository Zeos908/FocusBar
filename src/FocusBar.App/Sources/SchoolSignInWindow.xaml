<Window x:Class="FocusBar.App.Sources.SchoolSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to your school"
        Width="980" Height="760" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FlyoutBackground}"
        Foreground="{DynamicResource FlyoutForeground}"
        FontFamily="{StaticResource BarFont}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ItemHover}" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="DoneButton" Style="{StaticResource AccentButton}" Click="DoneButton_Click"
                        Margin="12,0,0,0" Content="I'm signed in" ToolTip="Click if FocusBar doesn't notice you've signed in" />
                <StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource FlyoutHeading}" Text="Sign in to your school website as you normally do." />
                    <TextBlock Style="{StaticResource FlyoutMuted}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="This is the real school site. FocusBar never sees your password. It keeps the signed-in session the site gives you, encrypted on this PC, and only reads your assignments and schedule." />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <wv2:WebView2 x:Name="Browser" />
            <TextBlock x:Name="LoadingText" Text="Loading…" Style="{StaticResource FlyoutMuted}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
