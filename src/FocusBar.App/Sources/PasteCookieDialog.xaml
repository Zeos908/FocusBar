<Window x:Class="FocusBar.App.Sources.PasteCookieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste your school session cookie"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FlyoutBackground}"
        Foreground="{DynamicResource FlyoutForeground}"
        FontFamily="{StaticResource BarFont}">
    <StackPanel Margin="20">
        <TextBlock Text="Paste your session cookie" Style="{StaticResource FlyoutHeading}" FontSize="16" />
        <TextBlock Style="{StaticResource FlyoutMuted}" TextWrapping="Wrap" Margin="0,6,0,0">
            Use this if the sign-in window doesn't work on this PC.
        </TextBlock>

        <TextBlock Text="How to get it (about 30 seconds)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBlock x:Name="StepsText" TextWrapping="Wrap" LineHeight="20" />

        <TextBlock Text="Cookie" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="CookieBox" Style="{StaticResource FormTextBox}" Height="90" TextWrapping="Wrap" AcceptsReturn="False"
                 FontFamily="Consolas, Cascadia Mono" FontSize="12" VerticalScrollBarVisibility="Auto"
                 Tag="t=...; AuthSvcToken=...; ..." AutomationProperties.Name="Cookie" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource FieldError}" />

        <TextBlock Style="{StaticResource FlyoutMuted}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="The cookie works like a password while it's valid, so don't share it. FocusBar stores it encrypted for your Windows account only, and it expires on its own after a while." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource FlyoutButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="ConnectButton" Style="{StaticResource AccentButton}" Content="Connect" IsDefault="True" Click="Connect_Click" />
        </StackPanel>
    </StackPanel>
</Window>
