<UserControl x:Class="FocusBar.App.Focus.FocusButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The moon: Focus Mode. When it's on, it fills in with the accent color and shows the time left. -->
    <Button x:Name="Button" Style="{StaticResource BarButton}" MinWidth="36" Padding="8,0" Margin="2,6" Click="Button_Click"
            AutomationProperties.Name="Focus Mode">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Icon" Text="&#xE708;" Style="{StaticResource IconText}" FontSize="14" />
            <TextBlock x:Name="TimeText" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </Button>
</UserControl>
