<Window x:Class="FocusBar.App.Focus.AppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an app to block"
        Width="460" Height="560" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FlyoutBackground}"
        Foreground="{DynamicResource FlyoutForeground}"
        FontFamily="{StaticResource BarFont}">
    <DockPanel Margin="16">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Search apps"
                 TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search apps" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Style="{StaticResource FieldError}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Style="{StaticResource FlyoutButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource AccentButton}" Content="Block this app" IsDefault="True" Click="Choose_Click" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="AppList" Style="{StaticResource FlyoutList}" Margin="0,10,0,0" MouseDoubleClick="AppList_MouseDoubleClick"
                 AutomationProperties.Name="Apps">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" Margin="4,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource FlyoutMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
