<Window x:Class="FocusBar.App.Focus.FocusScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Mode"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource BarFont}" Foreground="White">
    <Grid>
        <!-- Background: the student's own Focus Mode image (Phase 7), or this calm gradient. -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0F172A" Offset="0" />
                <GradientStop Color="#FF1E3A8A" Offset="0.6" />
                <GradientStop Color="#FF4F46E5" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed" />
        <!-- Darkens a custom image so the text stays readable. -->
        <Border x:Name="Scrim" Background="#8C000000" Visibility="Collapsed" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Padding="40,36"
                CornerRadius="16" Background="#59000000">
            <StackPanel>
                <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="44" HorizontalAlignment="Center" Opacity="0.9" />
                <TextBlock x:Name="HeadingText" Text="Time to focus" FontSize="34" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock x:Name="MessageText" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock x:Name="ReasonText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock x:Name="CountdownText" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock x:Name="UnlockText" FontSize="14" Opacity="0.75" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,4,0,0" />

                <WrapPanel HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="BackButton" Style="{StaticResource AccentButton}" Padding="20,10" Margin="6" FontSize="15"
                            Content="Back to work" Click="Back_Click" IsDefault="True" />
                    <Button x:Name="ContinueButton" Style="{StaticResource FlyoutButton}" Foreground="White" Padding="20,10" Margin="6"
                            FontSize="15" Content="Continue anyway" Click="Continue_Click" Visibility="Collapsed" />
                    <Button x:Name="OverrideButton" Style="{StaticResource FlyoutButton}" Foreground="White" Padding="20,10" Margin="6"
                            FontSize="15" Click="Override_Click" Visibility="Collapsed" IsEnabled="False" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
