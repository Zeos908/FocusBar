<local:FlyoutWindow x:Class="FocusBar.App.Flyouts.CalendarFlyout"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FocusBar.App.Flyouts"
                    xmlns:controls="clr-namespace:FocusBar.App.Controls"
                    Title="FocusBar Calendar">
    <Border Style="{StaticResource FlyoutChrome}">
        <StackPanel Margin="16" Width="300">
            <TextBlock x:Name="TodayText" Style="{StaticResource FlyoutHeading}" FontSize="16" />
            <TextBlock x:Name="TimeText" Style="{StaticResource FlyoutMuted}" FontSize="13" Margin="0,2,0,12" />

            <controls:MonthCalendar x:Name="Calendar" />

            <Border BorderBrush="{DynamicResource FlyoutDivider}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0">
                <Button Style="{StaticResource FlyoutButton}" HorizontalAlignment="Right" Click="DateTimeSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Date &amp; time settings" />
                    </StackPanel>
                </Button>
            </Border>
        </StackPanel>
    </Border>
</local:FlyoutWindow>
