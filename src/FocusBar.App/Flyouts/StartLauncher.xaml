<local:FlyoutWindow x:Class="FocusBar.App.Flyouts.StartLauncher"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FocusBar.App.Flyouts"
                    Title="FocusBar Start">
    <Border Style="{StaticResource FlyoutChrome}" Width="380">
        <DockPanel Margin="12">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}"
                     Tag="Type to search apps" AutomationProperties.Name="Search apps"
                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource FlyoutDivider}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlyoutButton}" Click="OpenWindowsStart_Click"
                            ToolTip="Open the regular Windows Start menu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Windows Start menu" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusText" Style="{StaticResource FlyoutMuted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="Right-click an app to pin it" />
                </DockPanel>
            </Border>

            <Grid Margin="0,8,0,0" Height="420">
                <ListBox x:Name="AppList" Style="{StaticResource FlyoutList}" AutomationProperties.Name="Apps"
                         PreviewMouseLeftButtonUp="AppList_MouseLeftButtonUp" KeyDown="AppList_KeyDown"
                         ContextMenuOpening="AppList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="PinMenuItem" Header="Pin to FocusBar" Click="PinMenuItem_Click" />
                            <MenuItem Header="Open" Click="OpenMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="PinMark" DockPanel.Dock="Right" Text="&#xE718;" Style="{StaticResource IconText}"
                                           FontSize="12" Foreground="{DynamicResource FlyoutMutedForeground}"
                                           Visibility="Collapsed" ToolTip="Pinned to FocusBar" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="PinMark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource FlyoutMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</local:FlyoutWindow>
