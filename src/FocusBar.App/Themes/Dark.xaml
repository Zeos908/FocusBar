<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Used when Windows is in dark mode. Every color the UI uses must also be defined in Light.xaml. -->
    <SolidColorBrush x:Key="BarBackground" Color="#FF1F1F23" />
    <SolidColorBrush x:Key="BarForeground" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="BarMutedForeground" Color="#99F3F3F3" />
    <SolidColorBrush x:Key="BarHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BarPressed" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BarPlaceholderBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#FF4F8EF7" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FF0B1A33" />
    <SolidColorBrush x:Key="IndicatorOpen" Color="#99F3F3F3" />
    <SolidColorBrush x:Key="IndicatorFlashing" Color="#FFF7A64F" />

    <SolidColorBrush x:Key="FlyoutBackground" Color="#FF2B2B30" />
    <SolidColorBrush x:Key="FlyoutBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FlyoutForeground" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="FlyoutMutedForeground" Color="#A6F3F3F3" />
    <SolidColorBrush x:Key="FlyoutDivider" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="InputBackground" Color="#FF1F1F23" />
    <SolidColorBrush x:Key="InputBorder" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="ItemHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ItemSelected" Color="#29FFFFFF" />
</ResourceDictionary>
