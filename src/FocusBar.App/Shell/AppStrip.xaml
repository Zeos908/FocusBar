<UserControl x:Class="FocusBar.App.Shell.AppStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusBar.App.Controls"
             Focusable="False">
    <!-- One button per app: pinned apps first, then other open apps. All of an app's windows share its button.
         Click: open it (pinned, not open) / switch to or minimize it (one window) / pick a window (several).
         Middle-click closes a single window. Right-click for more. -->
    <ItemsControl x:Name="Buttons" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:ShrinkingStackPanel ItemWidth="44" MinItemWidth="28" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource BarButton}" MinWidth="0" Margin="1,4" Padding="0"
                        ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}"
                        PreviewMouseLeftButtonDown="AppButton_PreviewMouseLeftButtonDown"
                        Click="AppButton_Click" MouseUp="AppButton_MouseUp"
                        ContextMenuOpening="AppButton_ContextMenuOpening">
                    <Button.ContextMenu>
                        <ContextMenu />
                    </Button.ContextMenu>
                    <Grid>
                        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Shown until (or if) the app's own icon can't be loaded, so a button is never blank. -->
                        <TextBlock x:Name="FallbackIcon" Text="&#xE71D;" Style="{StaticResource IconText}" FontSize="18"
                                   Visibility="Collapsed" />
                        <!-- How many windows, when there's more than one. -->
                        <Border x:Name="CountBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-8,0"
                                MinWidth="15" Height="15" CornerRadius="7.5" Padding="3,0" Visibility="Collapsed"
                                Background="{DynamicResource Accent}" IsHitTestVisible="False">
                            <TextBlock Text="{Binding CountText}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentForeground}" />
                        </Border>
                        <!-- Under the icon: nothing when not open, a dot when open, wide accent when it has the focused
                             window, orange when it wants attention. -->
                        <Border x:Name="Indicator" Height="3" Width="6" CornerRadius="1.5" VerticalAlignment="Bottom"
                                Margin="0,0,0,-8" Background="{DynamicResource IndicatorOpen}" />
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                        <Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowCount}" Value="True">
                        <Setter TargetName="CountBadge" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Closed">
                        <Setter TargetName="Indicator" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Active">
                        <Setter TargetName="Indicator" Property="Width" Value="16" />
                        <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Flashing">
                        <Setter TargetName="Indicator" Property="Width" Value="16" />
                        <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource IndicatorFlashing}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
