<UserControl x:Class="FocusBar.App.Shell.TaskStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusBar.App.Controls"
             Focusable="False">
    <!-- Open windows. Click to switch to a window, click the active one to minimize it, right-click for more. -->
    <ItemsControl x:Name="Windows" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:ShrinkingStackPanel ItemWidth="44" MinItemWidth="28" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource BarButton}" MinWidth="0" Margin="1,4" Padding="0"
                        ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                        PreviewMouseLeftButtonDown="WindowButton_PreviewMouseLeftButtonDown"
                        Click="WindowButton_Click" MouseUp="WindowButton_MouseUp"
                        ContextMenuOpening="WindowButton_ContextMenuOpening">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Pin to FocusBar" Click="PinMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="Close window" Click="CloseMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Small bar under the icon: accent and wide for the active window, orange when it wants attention. -->
                        <Border x:Name="Indicator" Height="3" Width="6" CornerRadius="1.5" VerticalAlignment="Bottom"
                                Margin="0,0,0,-8" Background="{DynamicResource IndicatorOpen}" />
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Active">
                        <Setter TargetName="Indicator" Property="Width" Value="16" />
                        <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Flashing">
                        <Setter TargetName="Indicator" Property="Width" Value="16" />
                        <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource IndicatorFlashing}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
