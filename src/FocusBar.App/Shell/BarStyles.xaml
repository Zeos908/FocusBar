<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Placeholder look until themes land in Phase 7. -->
    <SolidColorBrush x:Key="BarBackground" Color="#FF1F1F23" />
    <SolidColorBrush x:Key="BarForeground" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="BarMutedForeground" Color="#99F3F3F3" />
    <SolidColorBrush x:Key="BarHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BarPressed" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BarPlaceholderBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#FF4F8EF7" />

    <FontFamily x:Key="BarFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons ships with Windows 11; Segoe MDL2 Assets is the Windows 10 equivalent. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="BarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="2,4" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{StaticResource Accent}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BarHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BarPressed}" />
                        </Trigger>
                        <!-- Keyboard focus ring for Tab navigation. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dashed box marking where a not-yet-built feature will go. -->
    <Style x:Key="Placeholder" TargetType="Border">
        <Setter Property="Margin" Value="4,8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BarPlaceholderBorder}" />
    </Style>

    <Style x:Key="PlaceholderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BarMutedForeground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
