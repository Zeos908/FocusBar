<flyouts:FlyoutWindow x:Class="FocusBar.App.Shell.WindowListFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:flyouts="clr-namespace:FocusBar.App.Flyouts"
                      Title="FocusBar Windows">
    <Border Style="{StaticResource FlyoutChrome}">
        <StackPanel Margin="10" Width="320">
            <DockPanel Margin="4,0,0,6">
                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Tooltip}" Style="{StaticResource FlyoutHeading}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <!-- One row per window: click to switch to it; × closes it. -->
                <ItemsControl x:Name="WindowRows" ItemsSource="{Binding Windows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlyoutButton}" Padding="8,4" Margin="4,0,0,0"
                                        Click="CloseWindow_Click" ToolTip="Close window"
                                        AutomationProperties.Name="{Binding Title, StringFormat=Close {0}}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11" />
                                </Button>
                                <Button x:Name="Row" Style="{StaticResource FlyoutButton}" HorizontalContentAlignment="Left" Padding="8,7"
                                        Click="Window_Click" AutomationProperties.Name="{Binding Title}">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" />
                                        <TextBlock x:Name="RowTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <!-- The window you're in is shown in bold. -->
                                <DataTrigger Binding="{Binding State}" Value="Active">
                                    <Setter TargetName="RowTitle" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</flyouts:FlyoutWindow>
