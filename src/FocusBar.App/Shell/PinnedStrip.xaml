<UserControl x:Class="FocusBar.App.Shell.PinnedStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Pinned apps. Click to open; right-click to unpin or reorder. -->
    <ItemsControl x:Name="Pins" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource BarIconButton}" Width="44"
                        ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                        Click="PinButton_Click" ContextMenuOpening="PinButton_ContextMenuOpening">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="OpenMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="Move left" Click="MoveLeft_Click" />
                            <MenuItem Header="Move right" Click="MoveRight_Click" />
                            <Separator />
                            <MenuItem Header="Unpin from FocusBar" Click="Unpin_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
