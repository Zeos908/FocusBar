<appbar:AppBarWindow x:Class="FocusBar.App.Shell.MainBar"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
                     xmlns:shell="clr-namespace:FocusBar.App.Shell"
                     xmlns:tray="clr-namespace:FocusBar.App.Tray"
                     xmlns:controls="clr-namespace:FocusBar.App.Controls"
                     xmlns:ticker="clr-namespace:FocusBar.App.Ticker"
                     xmlns:focus="clr-namespace:FocusBar.App.Focus"
                     Title="FocusBar"
                     Background="{DynamicResource BarBackground}"
                     FontFamily="{StaticResource BarFont}"
                     Foreground="{DynamicResource BarForeground}"
                     KeyboardNavigation.TabNavigation="Cycle">
    <appbar:AppBarWindow.ContextMenu>
        <ContextMenu>
            <MenuItem Header="FocusBar settings" Click="Settings_Click" />
            <MenuItem Header="Task Manager" Click="TaskManager_Click" />
            <Separator />
            <MenuItem Header="Restore Windows taskbar and exit" Click="RestoreAndExit_Click" InputGestureText="Ctrl+Alt+Shift+F" />
            <Separator />
            <MenuItem Header="Open log folder" Click="OpenLogFolder_Click" />
            <MenuItem x:Name="DeveloperMenu" Header="Developer" Visibility="Collapsed">
                <MenuItem Header="Throw test exception (UI thread)" Click="ThrowUiException_Click" />
                <MenuItem Header="Throw test exception (background thread)" Click="ThrowBackgroundException_Click" />
            </MenuItem>
        </ContextMenu>
    </appbar:AppBarWindow.ContextMenu>

    <!-- Left to right: Start | deadline ticker (fills the rest) | pinned apps | open windows | Focus Mode | tray | clock.
         The left side belongs to the deadlines; app icons sit on the right with the other buttons. -->
    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The theme's background image, with a dark scrim so text stays readable on any picture. Sized in code
             to exactly the screen pixels it covers, so it's sharp at any scaling. -->
        <Grid x:Name="BackgroundLayer" Grid.ColumnSpan="5" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="BackgroundImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Border Background="#59000000" />
        </Grid>

        <Button Grid.Column="0" x:Name="StartButton" Style="{StaticResource BarIconButton}" Margin="4,4,2,4"
                Click="StartButton_Click" ContextMenuOpening="StartButton_ContextMenuOpening"
                ToolTip="Start" AutomationProperties.Name="Start">
            <Grid>
                <!-- Four tiles, or the theme's own Start icon. -->
                <Path x:Name="StartGlyph" Fill="{DynamicResource Accent}" Width="18" Height="18" Stretch="Uniform"
                      Data="M0,0 H8 V8 H0 Z M10,0 H18 V8 H10 Z M0,10 H8 V18 H0 Z M10,10 H18 V18 H10 Z" />
                <Image x:Name="StartImage" Stretch="Fill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Button>

        <!-- The ticker always keeps at least ReservedWidth; the app icons get the rest of what they need. -->
        <controls:BarMiddlePanel Grid.Column="1" ReservedWidth="300" Margin="4,0">
            <ticker:TickerView x:Name="Ticker" Margin="0,0,8,0" />
            <DockPanel>
                <shell:PinnedStrip DockPanel.Dock="Left" x:Name="Pinned" />
                <shell:TaskStrip x:Name="Tasks" />
            </DockPanel>
        </controls:BarMiddlePanel>

        <focus:FocusButton Grid.Column="2" x:Name="FocusMode" />

        <tray:TrayArea Grid.Column="3" x:Name="Tray" />

        <Button Grid.Column="4" x:Name="ClockButton" Style="{StaticResource BarButton}" Margin="2,4,6,4"
                Click="ClockButton_Click" AutomationProperties.Name="Clock and calendar">
            <StackPanel>
                <TextBlock x:Name="TimeText" FontSize="12" HorizontalAlignment="Right" />
                <TextBlock x:Name="DateText" FontSize="12" HorizontalAlignment="Right" />
            </StackPanel>
        </Button>
    </Grid>
</appbar:AppBarWindow>
