<UserControl x:Class="FocusBar.App.Media.NowPlayingButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- What's playing: cover, title, and artist (click for controls), plus a quick play/pause. Hidden when nothing is. -->
    <StackPanel Orientation="Horizontal" Margin="2,0">
        <Button x:Name="InfoButton" Style="{StaticResource BarButton}" Padding="6,0" Margin="0,4" MaxWidth="230" Click="Info_Click">
            <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource BarHover}">
                    <Grid>
                        <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="13" />
                        <Image x:Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="8,0,2,0">
                    <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource BarMutedForeground}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Button>
        <Button x:Name="PlayPauseButton" Style="{StaticResource BarIconButton}" Width="32" Click="PlayPause_Click">
            <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" Style="{StaticResource IconText}" FontSize="13" />
        </Button>
    </StackPanel>
</UserControl>
