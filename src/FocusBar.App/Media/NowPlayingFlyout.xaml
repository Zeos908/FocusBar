<flyouts:FlyoutWindow x:Class="FocusBar.App.Media.NowPlayingFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:flyouts="clr-namespace:FocusBar.App.Flyouts"
                      Title="FocusBar Now Playing">
    <Border Style="{StaticResource FlyoutChrome}">
        <StackPanel Margin="16" Width="300">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="96" Height="96" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ItemHover}">
                    <Grid>
                        <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="32" />
                        <Image x:Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel Margin="14,2,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AlbumText" Style="{StaticResource FlyoutMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AppText" Style="{StaticResource FlyoutMuted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Progress, when the player reports it (live streams don't). -->
            <StackPanel x:Name="TimelinePanel" Margin="0,16,0,0">
                <Grid Height="4">
                    <Border CornerRadius="2" Background="{DynamicResource InputBorder}" />
                    <Border CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Style="{StaticResource FlyoutMuted}" FontSize="11" />
                    <TextBlock x:Name="ElapsedText" Style="{StaticResource FlyoutMuted}" FontSize="11" />
                </DockPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="PreviousButton" Style="{StaticResource FlyoutButton}" Padding="12,8" Margin="4,0" Click="Previous_Click"
                        ToolTip="Previous" AutomationProperties.Name="Previous">
                    <TextBlock Text="&#xE892;" Style="{StaticResource IconText}" FontSize="16" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButton}" Padding="16,10" Margin="4,0" Click="PlayPause_Click">
                    <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" Style="{StaticResource IconText}" FontSize="18" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource FlyoutButton}" Padding="12,8" Margin="4,0" Click="Next_Click"
                        ToolTip="Next" AutomationProperties.Name="Next">
                    <TextBlock Text="&#xE893;" Style="{StaticResource IconText}" FontSize="16" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</flyouts:FlyoutWindow>
