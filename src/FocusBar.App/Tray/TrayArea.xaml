<UserControl x:Class="FocusBar.App.Tray.TrayArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tray="clr-namespace:FocusBar.App.Tray">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Button x:Name="OverflowButton" Style="{StaticResource TrayButton}" Click="OverflowButton_Click"
                ToolTip="Show hidden icons" AutomationProperties.Name="Show hidden icons">
            <TextBlock Text="&#xE70E;" Style="{StaticResource IconText}" FontSize="12" />
        </Button>

        <ItemsControl x:Name="PinnedIcons" Focusable="False" Margin="0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <tray:TrayIconView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource TrayButton}" Click="Network_Click"
                ToolTip="{Binding NetworkTooltip}" AutomationProperties.Name="{Binding NetworkTooltip}">
            <TextBlock Text="{Binding NetworkGlyph}" Style="{StaticResource IconText}" />
        </Button>

        <Button Style="{StaticResource TrayButton}" Click="Volume_Click" MouseWheel="Volume_MouseWheel" MouseUp="Volume_MouseUp"
                ToolTip="{Binding VolumeTooltip}" AutomationProperties.Name="{Binding VolumeTooltip}">
            <TextBlock Text="{Binding VolumeGlyph}" Style="{StaticResource IconText}" />
        </Button>

        <Button Style="{StaticResource TrayButton}" Click="Battery_Click"
                Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}"
                ToolTip="{Binding BatteryTooltip}" AutomationProperties.Name="{Binding BatteryTooltip}">
            <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource IconText}" />
        </Button>
    </StackPanel>
</UserControl>
